{
  "name": "ddato-drive",
  "version": "0.1.0",
  "description": "Self-hosted web drive backend for DDATO Drive",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "prebuild": "node scripts/prepare-background-assets.js",
    "predev": "node scripts/prepare-background-assets.js",
    "predev:web": "node scripts/prepare-background-assets.js",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "dev:web": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-test.js",
    "test:transfers": "node scripts/storage-performance-test.js && node scripts/upload-store-test.js && node scripts/transfer-progress-test.js",
    "test:transfer-ui": "node scripts/transfer-eta-browser-test.js",
    "test:background-removal": "npm run build && node scripts/background-removal-test.js && node scripts/background-removal-browser-test.js",
    "test:zip-preview": "node scripts/zip-preview-test.js",
    "test:archive-preview": "node scripts/archive-preview-test.js",
    "test:folder-upload": "node scripts/folder-upload-test.js",
    "test:trash-retention": "node --disable-warning=ExperimentalWarning scripts/trash-retention-test.js",
    "test:drag-move": "node scripts/drag-move-test.js",
    "test:resources": "node --disable-warning=ExperimentalWarning scripts/server-resource-test.js",
    "test:navigation": "npm run build && node scripts/navigation-test.js && node scripts/navigation-browser-test.js",
    "test:media-layout": "npm run build && node scripts/media-layout-browser-test.js",
    "test:thumbnails": "npm run build && node scripts/thumbnail-browser-test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "multer": "^2.1.1",
    "onnxruntime-web": "1.21.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2",
    "react-router": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "^8.1.0"
  }
}
